# 配置模板。复制为 .env.dev（pnpm dev 读取）或 .env.prod（pnpm start 读取）后填写，
# 两者都不入库。通过 Node 的 --env-file 加载，只支持 KEY=value。每项含义见 README「配置」。

NODE_ENV=development
HOST=127.0.0.1
PORT=4030
# 信任哪些反向代理传来的 X-Forwarded-*（Fastify trustProxy：loopback、IP/网段、逗号分隔列表）。
# 默认只信本机 nginx；不要写 true，否则客户端能伪造来源 IP 绕过限流。
# TRUST_PROXY=loopback

# SQLite 数据库，相对路径以 api/prisma/ 为基准；生产建议写绝对路径，如 file:/var/lib/team-knowledge/team-knowledge.db
DATABASE_URL=file:./dev.db
# 运行数据目录（上传文件、会议录音与语音）；生产必须设为源码目录之外的绝对路径，如 /var/lib/team-knowledge
DATA_DIR=./data

# 前端访问地址：WEB_ORIGIN 用于跨域白名单（不含路径），WEB_PUBLIC_URL 用于通知卡片里的链接（部署在子路径时带上路径）
WEB_ORIGIN=http://localhost:5030
WEB_PUBLIC_URL=http://localhost:5030

# AI 能力通过本机已登录的 Claude Code / Codex 命令行调用；不在 PATH 上时写绝对路径（也可在管理后台修改）
CLAUDE_BIN=claude
CODEX_BIN=codex
# 各引擎默认使用的模型，留空用命令行自己的默认模型；管理后台「AI 引擎」页可以覆盖。
# Claude Code 可写别名（opus、sonnet、haiku）或完整模型 ID；Codex 写 codex 支持的模型名
CLAUDE_MODEL=
CODEX_MODEL=

# 助手的显示名（界面、提示词、飞书卡片），默认 AI
# ASSISTANT_NAME=AI
# 会议唤醒词，逗号分隔，默认 小助手
# WAKE_WORDS=小助手

# 可选：飞书登录与飞书能力（feishu-sso 的 whoami 地址）。不设置为本地单用户模式
WHOAMI_URL=
# 启用登录后，首次登录即成为管理员的名单（逗号分隔，任一命中即可）
ADMIN_OPEN_IDS=
ADMIN_EMAILS=
ADMIN_PHONES=
# 与 feishu-sso 的服务间共享口令，两边必须一致；启用登录的生产环境必须改成强随机值（openssl rand -hex 24）
INTERNAL_API_TOKEN=dev-internal-token-change-in-prod

# 可选：飞书通知卡片的按钮用飞书 applink 在客户端内打开
FEISHU_CARD_USE_APPLINK=false
# 可选：自己的操作也通知自己（单人调试通知链路时用）
NOTIFY_INCLUDE_SELF=false
# 可选：各类飞书群通知的目标群 chat_id（oc_*，逗号分隔），留空表示不发
FEISHU_SKILL_NOTIFY_CHAT_IDS=
FEISHU_WEEKLY_DIGEST_CHAT_IDS=
FEISHU_MEETING_NOTIFY_CHAT_IDS=
FEISHU_DOC_AUDIT_NOTIFY_CHAT_IDS=
FEISHU_CHANGELOG_NOTIFY_CHAT_IDS=
FEISHU_KB_WEEKLY_REPORT_CHAT_IDS=
# 可选：通知测试页里把 chat_id 显示成群名，格式 oc_xxx=群名,oc_yyy=群名
FEISHU_CHAT_NAMES=

# 可选：会议实时转写与语音播报（火山引擎）。也可在管理后台填写；都不配置时使用占位实现
# 鉴权二选一：新版控制台只需 API Key；旧版控制台用 APP ID + Access Token。配置了 API Key 就优先用它
VOLC_STT_API_KEY=
VOLC_STT_APP_ID=
VOLC_STT_ACCESS_TOKEN=
VOLC_TTS_API_KEY=
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
# 以下均为可选的高级项，留空用默认值
# VOLC_STT_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# VOLC_STT_RESOURCE_ID=volc.bigasr.sauc.duration
# VOLC_STT_MODEL=bigmodel
# VOLC_STT_BOOSTING_TABLE_ID=
# 会议内联热词（逗号分隔，用于纠正同音词，如人名）；默认不带，设为 off 关闭
# VOLC_STT_HOTWORDS=
# VOLC_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# VOLC_TTS_VOICE=zh_female_wanwanxiaohe_moon_bigtts
# VOLC_TTS_RESOURCE_ID=volc.service_type.10029

# 可选：聊天里的生成图片（OpenAI 图片接口）
OPENAI_API_KEY=
# 使用兼容的网关或代理地址时填写，默认 https://api.openai.com/v1
# OPENAI_BASE_URL=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=medium
# 是否流式出图（0 关闭）、流式中间图数量
# OPENAI_IMAGE_STREAM=1
# OPENAI_IMAGE_PARTIALS=3
# 单次请求超时、总超时（毫秒）、最大重试次数
# OPENAI_IMAGE_TIMEOUT_MS=120000
# OPENAI_IMAGE_TOTAL_TIMEOUT_MS=300000
# OPENAI_IMAGE_RETRIES=3
# 在国内等需要代理才能访问 OpenAI 的环境：Node 的 fetch 默认不读代理变量，
# 必须同时设置 NODE_USE_ENV_PROXY=1 和 HTTPS_PROXY 才会走代理
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890

# 可选：AI 命令行调用的调参项
# 推理强度（传给 claude 的 --effort），默认用命令行自己的默认值
# LLM_EFFORT=
# 专家/总台助手回答时单独指定的推理强度，留空沿用 LLM_EFFORT
# ASSISTANT_EFFORT=
# 无输出超时 / 总时长上限（毫秒）；codex 不是流式输出，无输出超时单独设置
# LLM_IDLE_TIMEOUT_MS=90000
# LLM_HARD_TIMEOUT_MS=600000
# LLM_CODEX_IDLE_TIMEOUT_MS=300000
# 对话摘要用的模型：默认在 claude 引擎下用 claude-haiku-4-5，设 SUMMARY_PROVIDER=main 则与主引擎一致
# SUMMARY_PROVIDER=
# SUMMARY_MODEL=claude-haiku-4-5
