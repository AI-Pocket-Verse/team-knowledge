{
  "name": "@team-knowledge/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.dev --env-file-if-exists=.env.dev.local src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx --env-file=.env.prod dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "DATABASE_URL=\"file:./test.db\" prisma migrate deploy",
    "pretest:watch": "DATABASE_URL=\"file:./test.db\" prisma migrate deploy",
    "db:migrate": "node --env-file=.env.dev node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node --env-file=.env.prod node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --env-file=.env.dev prisma/seed.ts",
    "db:seed:prod": "tsx --env-file=.env.prod prisma/seed.ts",
    "cleanup-uploads": "node --import tsx --env-file=.env.dev scripts/cleanup-uploads.mjs",
    "cleanup-uploads:prod": "node --import tsx --env-file=.env.prod scripts/cleanup-uploads.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.9",
    "@fastify/websocket": "^11.0.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "5.22.0",
    "@resvg/resvg-js": "^2.6.2",
    "@team-knowledge/api-kit": "workspace:*",
    "@team-knowledge/auth-client-api": "workspace:*",
    "@team-knowledge/auth-core": "workspace:*",
    "@team-knowledge/db-kit": "workspace:*",
    "@team-knowledge/logger": "workspace:*",
    "@team-knowledge/shared": "workspace:*",
    "fastify": "5.12.8",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.3.4",
    "jszip": "^3.10.1",
    "tsx": "^4.16.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@team-knowledge/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "prisma": "5.22.0",
    "typescript": "5.4.5",
    "vitest": "^4.1.12",
    "ws": "^8.21.0"
  }
}
