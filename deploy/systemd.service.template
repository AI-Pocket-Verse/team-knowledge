[Unit]
Description=team-knowledge API
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__/api
EnvironmentFile=__INSTALL_DIR__/api/.env.prod
# The service user must be able to run `claude` / `codex` (installed and
# logged in once as that user). Add their directories here if they are not on
# this PATH, or set CLAUDE_BIN / CODEX_BIN in .env.prod.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# 内部包（packages/*、shared）以 TS 源码形式被引用，需要 tsx 加载器才能运行
ExecStart=/usr/bin/node --import tsx __INSTALL_DIR__/api/dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# index.ts drains the meeting WebSocket streams on SIGTERM before exiting.
TimeoutStopSec=30

# Sandboxing. ProtectHome=read-only (not `true`) so the `claude` / `codex`
# subprocesses can read their logged-in credentials from the service user's home.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

LimitNOFILE=8192
MemoryMax=2G

[Install]
WantedBy=multi-user.target
